#!/usr/bin/env bash

set -euo pipefail

readonly TARGET="x86_64-apple-darwin"

case "${1:-}" in
    "") ./script/build-target "$TARGET" ;;
    --dmg) ./script/bundle-mac "$TARGET" ;;
    -h|--help)
        echo "Usage: ${0##*/} [--dmg]"
        echo "Build MonyaCode for Intel macOS (${TARGET})."
        ;;
    *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
